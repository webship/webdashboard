<?php

/**
 * @file
 * Install, update and uninstall functions for the Web Dashboard module.
 */

declare(strict_types=1);

/**
 * Implements hook_uninstall().
 */
function webdashboard_uninstall(): void {
  // The personalized dashboards of every user.
  \Drupal::service('user.data')->delete('webdashboard');

  // Builder instances are content entities, so uninstalling the dashboards
  // configuration leaves the ones nobody reached through a dashboard behind.
  $storage = \Drupal::entityTypeManager()->getStorage('display_builder_instance');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('id', 'webdashboard', 'STARTS_WITH')
    ->execute();

  if ($ids) {
    $storage->delete($storage->loadMultiple($ids));
  }
}
